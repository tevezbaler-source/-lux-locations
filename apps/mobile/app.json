{
  "expo": {
    "name": "Lux Locations",
    "slug": "lux-locations",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "luxlocations",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.luxlocations.app",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.luxlocations.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#3a5f78"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3a5f78"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Lux Locations: İstanbul merkezli özel turlar, oteller, Boğaz turu ve rezervasyon.",
    "extra": {
      "eas": {
        "projectId": "0e2bb231-c5f7-4a27-ae34-71acaa85bf47"
      }
    },
    "owner": "foruzel"
  }
}
